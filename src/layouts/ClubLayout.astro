---
import '../styles/tokens.css';

/**
 * Ticket FE-13 — header theo branding riêng của club (`logo_url`/`primary_color`, đã gate Pro/Premium ở
 * Backend — Ticket 41/B.4, trang này không tự quyết định lại). SEO: title/description động theo club,
 * OpenGraph image = `logo_url` khi có; club Free/chưa có branding thật fallback về logo-mark chung thay vì bỏ
 * hẳn tag (đổi ở Ticket FE-24 — xem `ogImageUrl` bên dưới).
 *
 * Ticket FE-14 — khung layout/typography theo Design System chung (`tokens.css`); `--club-accent` (branding
 * RIÊNG từng club, `primary_color`) tiếp tục override `--color-brand-primary` — đây là 2 khái niệm khác
 * nhau, không gộp: `--color-brand-primary` là neutral palette fallback khi club chưa có branding thật.
 */
export interface Props {
  name: string;
  sportType: string;
  logoUrl: string | null;
  primaryColor: string | null;
  slug: string;
}

const { name, sportType, logoUrl, primaryColor, slug } = Astro.props;

const title = `${name} — Bảng xếp hạng Pickleheads`;
const description = `Bảng xếp hạng ${sportType} công khai của câu lạc bộ ${name} trên Pickleheads.`;
// `Astro.site` KHÔNG gồm `base` (`base` là 1 config riêng) — phải tự nối để ra đúng URL public thật trên
// GitHub Pages project-page (`https://cuunon9x.github.io/pickleheads-marketing-site/clubs/:slug/`).
// `BASE_URL` không đảm bảo có `/` cuối (phụ thuộc cách khai báo `base` ở astro.config.mjs) — tự chuẩn hoá
// để không dính lỗi nối chuỗi thiếu dấu `/` (VD "...marketing-siteclubs/...").
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(`${base}clubs/${slug}/`, Astro.site).toString();
// Ticket FE-14 — fallback ĐÚNG token `--color-brand-primary` (#1B6B52), KHÔNG còn hardcode `#1d4ed8` sai màu.
const accentColor = primaryColor ?? 'var(--color-brand-primary)';
// Ticket FE-24 — `og:image` không còn bỏ hẳn tag khi club chưa có `logo_url` riêng: fallback về logo-mark
// chung (cùng file `favicon.svg`), phải là absolute URL theo đúng OG spec.
const logoMarkUrl = new URL(`${base}favicon.svg`, Astro.site).toString();
const ogImageUrl = logoUrl ?? logoMarkUrl;
// schema.org SportsOrganization (Ticket FE-24) — `sport` là property có thật của type này, không phải suy diễn.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name,
  url: canonicalUrl,
  logo: ogImageUrl,
  sport: sportType,
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pickleheads" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style={`--club-accent: ${accentColor};`}>
    <header class="club-header">
      {logoUrl && <img src={logoUrl} alt={`Logo ${name}`} class="club-logo" />}
      <h1>{name}</h1>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-ink);
    background: var(--color-surface-100);
  }
  .club-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
    background: var(--club-accent, var(--color-brand-primary));
    color: #fff;
  }
  .club-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
  }
  .club-logo {
    height: 64px;
    width: 64px;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--elevation-1);
  }
  @media (max-width: 480px) {
    .club-header {
      padding: 1.5rem 1rem;
      gap: 0.75rem;
    }
    .club-header h1 {
      font-size: 1.35rem;
    }
    .club-logo {
      height: 48px;
      width: 48px;
    }
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem;
  }
</style>
