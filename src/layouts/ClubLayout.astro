---
import '../styles/tokens.css';
import PillNav from '../components/PillNav.astro';

/**
 * Ticket FE-13 — header theo branding riêng của club (`logo_url`/`primary_color`, đã gate Pro/Premium ở
 * Backend — Ticket 41/B.4, trang này không tự quyết định lại). SEO: title/description động theo club,
 * OpenGraph image = `logo_url` khi có; club Free/chưa có branding thật fallback về logo-mark chung thay vì bỏ
 * hẳn tag (đổi ở Ticket FE-24 — xem `ogImageUrl` bên dưới).
 *
 * Ticket FE-14 — khung layout/typography theo Design System chung (`tokens.css`); `--club-accent` (branding
 * RIÊNG từng club, `primary_color`) tiếp tục override `--color-brand-primary` — đây là 2 khái niệm khác
 * nhau, không gộp: `--color-brand-primary` là neutral palette fallback khi club chưa có branding thật.
 *
 * Ticket FE-25 — header phẳng cũ (`.club-header` full-width, màu accent) đổi sang `PillNav` (Design System
 * mục "Marketing surface — premium redesign"); mọi field/SEO ở trên (title/description/canonical/OG/JSON-LD)
 * giữ NGUYÊN, chỉ đổi phần render trong <body>. Href trỏ về homepage (`base`) để có đường quay lại danh sách
 * club — trước đây trang này không có link quay lại đâu cả.
 *
 * Ticket FE-29 — `og:image` fallback (club chưa có `logo_url` riêng) đổi từ `favicon.svg` sang
 * `og-banner.png` (Design System, nhóm asset "Logos", v16 — logo-only, không wordmark/tagline; tải 1 lần vào
 * repo, cùng pattern `logo-mark.svg` ở `apps/frontend`, KHÔNG fetch từ artifact lúc runtime). Ưu tiên vẫn
 * GIỮ NGUYÊN: `logoUrl` thật của club (Pro/Premium) > `og-banner.png` — chỉ đổi fallback, không đổi thứ tự
 * ưu tiên. `jsonLd.logo` KHÔNG đổi — vẫn dùng logo-mark thật (`favicon.svg`), vì banner có thêm hình tròn
 * trang trí không phù hợp ngữ nghĩa `Organization.logo`.
 */
export interface Props {
  name: string;
  sportType: string;
  logoUrl: string | null;
  primaryColor: string | null;
  slug: string;
}

const { name, sportType, logoUrl, primaryColor, slug } = Astro.props;

const title = `${name} — Bảng xếp hạng Pickleheads`;
const description = `Bảng xếp hạng ${sportType} công khai của câu lạc bộ ${name} trên Pickleheads.`;
// `Astro.site` KHÔNG gồm `base` (`base` là 1 config riêng) — phải tự nối để ra đúng URL public thật trên
// GitHub Pages project-page (`https://cuunon9x.github.io/pickleheads-marketing-site/clubs/:slug/`).
// `BASE_URL` không đảm bảo có `/` cuối (phụ thuộc cách khai báo `base` ở astro.config.mjs) — tự chuẩn hoá
// để không dính lỗi nối chuỗi thiếu dấu `/` (VD "...marketing-siteclubs/...").
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(`${base}clubs/${slug}/`, Astro.site).toString();
// Ticket FE-14 — fallback ĐÚNG token `--color-brand-primary` (#1B6B52), KHÔNG còn hardcode `#1d4ed8` sai màu.
const accentColor = primaryColor ?? 'var(--color-brand-primary)';
// Ticket FE-24 — `og:image` không còn bỏ hẳn tag khi club chưa có `logo_url` riêng. `logoMarkUrl` dùng cho
// `jsonLd.logo` (favicon.svg — logo mark thật, không có hình trang trí). Ticket FE-29 — fallback riêng cho
// `og:image` meta đổi sang `og-banner.png` (banner đúng tỉ lệ OG, không phải favicon vuông).
const logoMarkUrl = new URL(`${base}favicon.svg`, Astro.site).toString();
const ogBannerUrl = new URL(`${base}og-banner.png`, Astro.site).toString();
const ogImageUrl = logoUrl ?? ogBannerUrl;
// schema.org SportsOrganization (Ticket FE-24) — `sport` là property có thật của type này, không phải suy diễn.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name,
  url: canonicalUrl,
  logo: logoUrl ?? logoMarkUrl,
  sport: sportType,
};
// Ticket FE-25 — fallback initial cho PillNav khi club chưa có `logo_url` riêng (cùng pattern initial-avatar
// đã dùng ở RankingTable.astro cho player không có avatar).
const navInitial = name.trim().charAt(0).toUpperCase() || '?';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pickleheads" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style={`--club-accent: ${accentColor};`}>
    <PillNav title={name} href={base} logoUrl={logoUrl} fallbackInitial={navInitial} accentColor={accentColor} />
    <h1 class="club-title" data-reveal>{name}</h1>
    <main>
      <slot />
    </main>

    <script>
      import { initScrollReveal } from '../lib/scroll-reveal';
      initScrollReveal();
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-ink);
    background: var(--color-surface-100);
    overflow-x: hidden;
  }
  .club-title {
    max-width: 960px;
    margin: var(--space-6) auto 0;
    padding: 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--club-accent, var(--color-brand-primary));
  }
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-4);
  }
</style>
