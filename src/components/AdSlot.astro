---
import '../styles/tokens.css';

/**
 * Ticket FE-13 — giữ layout đúng kích thước chuẩn IAB, CHƯA gắn AdSense thật (chỉ đặt chỗ). Khi gắn thật,
 * thay nội dung bên trong bằng snippet AdSense — không đổi kích thước/id đã đặt sẵn ở đây (SEO/CLS đã ổn
 * định theo kích thước cố định ngay từ đầu).
 */
export interface Props {
  variant: 'leaderboard' | 'sidebar';
}

const { variant } = Astro.props;
const size = variant === 'leaderboard' ? { width: 728, height: 90 } : { width: 300, height: 250 };
---

<div
  class="ad-slot"
  data-ad-variant={variant}
  style={`width: ${size.width}px; height: ${size.height}px;`}
>
  <span>Quảng cáo {size.width}×{size.height}</span>
</div>

<style>
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    max-width: 100%;
    background: var(--color-surface-300);
    border: 1px dashed var(--color-border);
    color: var(--color-ink-muted);
    font-size: 0.75rem;
    font-family: var(--font-body);
  }
</style>
