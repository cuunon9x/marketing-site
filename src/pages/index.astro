---
import '../styles/tokens.css';
import PillNav from '../components/PillNav.astro';
import LeadForm from '../components/LeadForm.astro';
import { listAllPublicClubs } from '../lib/api.js';

/** Ticket FE-13 — trang chủ tối thiểu: danh sách link tới mọi club public (không nằm trong scope gốc của
 * ticket, nhưng cần thiết để có 1 trang gốc hợp lệ thay vì 404 mặc định của Astro, và giúp Googlebot có
 * điểm vào để discover mọi trang `/clubs/:slug` qua liên kết nội bộ, không chỉ qua sitemap.xml).
 * Ticket FE-14 — cùng token/font với `/clubs/:slug` (`tokens.css`), khung layout chung KHÔNG có branding
 * riêng club nào ở trang này (không phải trang của 1 club cụ thể).
 * Ticket FE-24 — card-grid (`radius-md`/`elevation-1`) thay `<ul>` trần, mỗi card thêm badge `sport_type` +
 * `member_count`; empty state khi chưa có club public nào (trước đây render `<ul>` rỗng không rõ ràng).
 * Ticket FE-25 — premium redesign: pill nav, hero/Attention section, club-grid đổi sang bento bất đối xứng
 * (Interest), Action section cuối trang cho chủ sân — data/SEO (title/description/canonical/OG) giữ nguyên
 * từ FE-24, chỉ đổi phần visual/markup bên trong <body>. Xem Design System artifact mục "Marketing surface —
 * premium redesign" (https://claude.ai/artifact/EQZN8wPstWHxrZrzQu68zt) cho quyết định font/icon/GSAP/layout.
 * Ticket FE-29 — thêm `og:image` (trang chủ trước đây KHÔNG có tag này) = `og-banner.png` (Design System,
 * nhóm asset "Logos", v16 — logo-only, không wordmark/tagline; tải 1 lần vào repo, cùng pattern
 * `logo-mark.svg` ở `apps/frontend`/`og-banner.png` ở `ClubLayout.astro`, KHÔNG fetch từ artifact runtime). */
const clubs = await listAllPublicClubs();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(base, Astro.site).toString();
const ogImageUrl = new URL(`${base}og-banner.png`, Astro.site).toString();
const title = 'Pickleheads — Bảng xếp hạng câu lạc bộ';
const description = 'Danh sách câu lạc bộ pickleball/tennis/badminton/padel công khai trên Pickleheads.';

// Ticket FE-25 — bento bất đối xứng (Design System "Asymmetrical Bento" + gpt-taste §4 grid-auto-flow: dense,
// không ô trống): pattern lặp theo index (KHÔNG random — build SSG phải deterministic) để card lớn nằm rải
// rác, không dồn liền nhau; card 1x1 lấp mọi ô trống còn lại nhờ `dense`.
function bentoVariant(index: number): 'feature' | 'wide' | 'normal' {
  const cycle = index % 7;
  if (cycle === 3) return 'feature';
  if (cycle === 6) return 'wide';
  return 'normal';
}
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pickleheads" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <PillNav title="Pickleheads" href={base} logoUrl={`${base}favicon.svg`} />

    <section class="hero" data-reveal>
      <span class="hero__eyebrow">CỘNG ĐỒNG THỂ THAO VỢT</span>
      <h1 class="hero__title">Bảng xếp hạng minh bạch cho câu lạc bộ của bạn</h1>
      <p class="hero__subtitle">
        Pickleheads theo dõi trận đấu, tính điểm rating và xếp hạng cho cộng đồng pickleball, tennis, badminton
        và padel — xác thực rõ ràng, cập nhật theo thời gian thực.
      </p>
      <a class="btn-pill" href="#clubs">
        Xem bảng xếp hạng
        <span class="btn-pill__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        </span>
      </a>
    </section>

    <section id="clubs" class="clubs-section">
      {
        clubs.length === 0 ? (
          <p class="empty-state" data-reveal>
            Chưa có câu lạc bộ công khai nào.
          </p>
        ) : (
          <ul class="club-grid">
            {clubs.map((club, index) => {
              const variant = bentoVariant(index);
              return (
                <li class={`club-card club-card--${variant}`} data-reveal>
                  <a href={`clubs/${club.slug}/`}>
                    <span class="club-meta">
                      <span class="badge">{club.sport_type}</span>
                      <span class="member-count">{club.member_count} thành viên</span>
                    </span>
                    <span class="club-name">{club.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <section class="action-section" data-reveal>
      <span class="action-section__eyebrow">DÀNH CHO CHỦ SÂN</span>
      <h2 class="action-section__title">Quản lý CLB của bạn trên Pickleheads</h2>
      <p class="action-section__subtitle">
        Đưa bảng xếp hạng CLB của bạn lên Pickleheads — theo dõi mùa giải, xác thực trận đấu và giữ chân hội
        viên với một trang công khai đẹp, chuyên nghiệp.
      </p>
      <!-- Ticket FE-29 — CTA mailto: cũ (Ticket FE-25, "chưa cần form thật") thay bằng form liên hệ thật,
           POST public/marketing/leads (BE-42). -->
      <LeadForm />
    </section>

    <script>
      import { initScrollReveal } from '../lib/scroll-reveal';
      initScrollReveal();
    </script>
  </body>
</html>

<style>
  body {
    font-family: var(--font-body);
    color: var(--color-ink);
    background: var(--color-surface-100);
    margin: 0;
    overflow-x: hidden;
  }
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-4) var(--space-8);
    text-align: center;
  }
  .hero__eyebrow {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-300);
    color: var(--color-ink-muted);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-4);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }
  .hero__subtitle {
    color: var(--color-ink-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }

  .clubs-section {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }
  .empty-state {
    color: var(--color-ink-muted);
    text-align: center;
  }
  .club-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-flow: dense;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .club-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
    .club-card--feature,
    .club-card--wide {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .club-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .club-card--feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .club-card--wide {
      grid-column: span 2;
      grid-row: span 1;
    }
  }
  .club-card {
    background: var(--color-surface-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--elevation-1);
    transition: box-shadow var(--duration-base) var(--ease-standard);
  }
  @media (prefers-reduced-motion: no-preference) {
    .club-card {
      transition:
        box-shadow var(--duration-base) var(--ease-standard),
        transform var(--duration-base) var(--ease-standard);
    }
    .club-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--elevation-2);
    }
  }
  .club-card a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-6);
    color: inherit;
    text-decoration: none;
  }
  .club-card--feature a {
    padding: var(--space-6);
  }
  .club-card--feature .club-name {
    font-size: 1.6rem;
  }
  .club-card--wide .club-name {
    font-size: 1.25rem;
  }
  .club-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .club-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .badge {
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--color-surface-300);
    color: var(--color-ink);
    font-weight: 600;
    text-transform: capitalize;
  }

  .action-section {
    max-width: 720px;
    margin: var(--space-8) auto 0;
    padding: var(--space-12) var(--space-4);
    text-align: center;
    background: var(--color-ink);
    color: var(--color-surface-100);
    border-radius: var(--radius-lg);
  }
  .action-section__eyebrow {
    display: inline-block;
    color: var(--color-surface-300);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-4);
  }
  .action-section__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin: 0 0 var(--space-4);
  }
  .action-section__subtitle {
    color: var(--color-surface-300);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }
</style>
